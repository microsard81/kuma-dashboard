# ------------------------------------------------------------
# Variabili d'ambiente obbligatorie per IN.VA Uptime Dashboard
# Copiare questo file in .env e compilare con i valori reali
# ------------------------------------------------------------

FLASK_SECRET_KEY=
STATUS_TOKEN=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

# --- APNs (Apple Push Notification service) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# --- Apple Watch ---
WATCH_API_TOKEN=

# --- Inverter / Sensori ---
# URL dell'endpoint invadcstatus (default: http://127.0.0.1:9000/invadcstatus)
INVERTER_STATUS_URL=

# --- Stato Sonde Kuma ---
# URL dell'endpoint probe-health del webhook (default: http://127.0.0.1:9000/probe-health)
# Autenticazione: stesso STATUS_TOKEN
PROBE_HEALTH_URL=
# Rilevamenti consecutivi oltre soglia prima di confermare stato critical (default: 5)
SENSOR_CRITICAL_DEBOUNCE=5

# --- Push notification log (lasciare vuoto per disabilitare) ---
PUSH_LOG_FILE=
# --- Reset password via email (SMTP) ---
# Server SMTP per l'invio dei link di reset. TLS obbligatorio:
# porta 465 = SMTPS (TLS implicito); altre porte richiedono SMTP_STARTTLS=true,
# altrimenti l'invio viene rifiutato.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Credenziali SMTP (lasciare SMTP_USERNAME vuoto se il server non richiede login)
SMTP_USERNAME=
SMTP_PASSWORD=
# Mittente delle email
SMTP_FROM=noreply@example.com
# true/false (accetta anche 1/0, yes/no, on/off)
SMTP_STARTTLS=true
# Validita' del link di reset in minuti (1..1440, default 30)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# URL pubblico del dashboard usato nei link delle email (deve iniziare con https://)
PUBLIC_BASE_URL=https://kuma-dashboard.example.com
# Email dell'admin avvisata a ogni reset completato (vuoto = avviso disattivato)
ADMIN_NOTIFY_EMAIL=
# Numero di reverse proxy fidati davanti a gunicorn per ricavare l'IP client
# da X-Forwarded-For (1..5, default 2: proxy upstream + Apache)
TRUSTED_PROXY_COUNT=2
