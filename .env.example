# ------------------------------------------------------------
# Variabili d'ambiente obbligatorie per IN.VA Uptime Dashboard
# Copiare questo file in .env e compilare con i valori reali
# ------------------------------------------------------------

FLASK_SECRET_KEY=
STATUS_TOKEN=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

# --- APNs (Apple Push Notification service) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# --- Apple Watch ---
WATCH_API_TOKEN=

# --- Push notification log (lasciare vuoto per disabilitare) ---
PUSH_LOG_FILE=
